# 从 @BotFather 获取
BOT_TOKEN=123456:ABC...

# Telegram Stars（XTR 数字商品）：可留空，API 使用空字符串即可，无需 BotFather 支付商 token
# 若卖实体商品并走 Stripe 等，再在 BotFather → 你的机器人 → Payments 连接支付商，把 token 填这里
PAYMENT_PROVIDER_TOKEN=

# 可选：管理员 Telegram 数字 ID，用于 /restock 等命令（逗号分隔）
ADMIN_IDS=

# SQLite 数据库路径（默认 data/bot.db）
DATABASE_PATH=data/bot.db

# 网络：若系统里配置了 HTTPS_PROXY 但代理不可用，会出现 TimedOut/ConnectTimeout
# 设为 0 表示不让 httpx 读取环境变量里的代理，改为直连 api.telegram.org
TELEGRAM_TRUST_ENV=1

# 若所在网络无法直连 Telegram，在此填写本地代理，例如：
# TELEGRAM_PROXY=http://127.0.0.1:7890
# TELEGRAM_PROXY=socks5://127.0.0.1:7890
# （socks5 需：pip install "python-telegram-bot[socks]"）
TELEGRAM_PROXY=
